---
source: src/plan.rs
expression: plan_json
input_file: tests/input/history_visibility.json5
---
{
  "new_user_id": "@new:example.com",
  "old_user_id": "@old:example.com",
  "rooms": {
    "!already-joined:example.com": {
      "errors": [
        {
          "RestrictedHistoryVisibility": {
            "already_joined": true,
            "visibility": "joined"
          }
        }
      ]
    },
    "!invited:example.com": {
      "errors": [
        {
          "RestrictedHistoryVisibility": {
            "already_joined": false,
            "visibility": "invited"
          }
        }
      ],
      "invite": true,
      "join": true
    },
    "!joined:example.com": {
      "errors": [
        {
          "RestrictedHistoryVisibility": {
            "already_joined": false,
            "visibility": "joined"
          }
        }
      ],
      "invite": true,
      "join": true
    },
    "!shared:example.com": {
      "invite": true,
      "join": true
    },
    "!word-readable:example.com": {
      "invite": true,
      "join": true
    }
  }
}

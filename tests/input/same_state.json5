// New user has the same state in all of the joined rooms as the old user. This
// should be a no-op.
{
    "rooms": {
        "!room1:example.com": [
            {
                "type": "m.room.member",
                "state_key": "@old:example.com",
                "content": {
                    "membership": "join"
                }
            },
            {
                "type": "m.room.member",
                "state_key": "@new:example.com",
                "content": {
                    "membership": "join"
                }
            },
            {
                "type": "m.room.power_levels",
                "state_key": "",
                "content": {
                    "users": {
                        "@old:example.com": 100,
                        "@new:example.com": 100
                    }
                }
            }
        ]
    },
    "old_user": {
        "user_id": "@old:example.com"
    },
    "new_user": {
        "user_id": "@new:example.com"
    }
}

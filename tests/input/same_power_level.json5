// Old user has the same power level as the new user. Copying the power level
// from the old to new user would be harmless, but generate state spam so we
// should avoid it.
{
    "rooms": {
        "!room1:example.com": [
            {
                "type": "m.room.member",
                "state_key": "@old:example.com",
                "content": {
                    "membership": "join"
                }
            },
            {
                "type": "m.room.member",
                "state_key": "@new:example.com",
                "content": {
                    "membership": "join"
                }
            },
            {
                "type": "m.room.power_levels",
                "state_key": "",
                "content": {
                    "users": {
                        "@old:example.com": 50,
                        "@new:example.com": 50
                    }
                }
            },
        ]
    },
    "old_user": {
        "user_id": "@old:example.com"
    },
    "new_user": {
        "user_id": "@new:example.com"
    }
}
